<%- include('partials/header') %>
<div class="row between">
  <h1>Clínicas</h1>
  <a class="btn" href="/admin/clinicas/nova">+ Nova clínica</a>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>

<% if (clinicas.length === 0) { %>
  <div class="card"><p class="muted">Nenhuma clínica ainda. Crie a primeira ou rode <code>npm run seed</code>.</p></div>
<% } else { %>
  <div class="cards">
    <% clinicas.forEach(function(c){ %>
      <a class="card" href="/admin/clinicas/<%= c.id %>">
        <div class="row between">
          <strong style="font-size:16px;color:var(--ink)"><%= c.name %></strong>
          <span class="badge <%= c.isActive ? 'on' : 'off' %>"><%= c.isActive ? 'Ativa' : 'Inativa' %></span>
        </div>
        <div class="muted" style="margin-top:2px"><%= c.slug %></div>
        <div class="muted" style="margin-top:8px">📱 <%= c.whatsappPhoneNumberId %></div>
        <div class="stat">
          <div><b><%= c._count.doctors %></b><span>médicos</span></div>
          <div><b><%= c._count.slots %></b><span>horários</span></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
