<%- include('partials/header') %>
<div class="row between">
  <h1>Clínicas</h1>
  <a class="btn" href="/admin/clinicas/nova">+ Nova clínica</a>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>

<div class="card">
  <% if (clinicas.length === 0) { %>
    <p class="muted">Nenhuma clínica ainda. Crie a primeira ou rode <code>npm run seed</code>.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Nome</th><th>Slug</th><th>Nº WhatsApp</th><th>Médicos</th><th>Horários</th><th>Ativa</th><th></th></tr>
      </thead>
      <tbody>
        <% clinicas.forEach(function(c){ %>
          <tr>
            <td><%= c.name %></td>
            <td class="muted"><%= c.slug %></td>
            <td class="muted"><%= c.whatsappPhoneNumberId %></td>
            <td><%= c._count.doctors %></td>
            <td><%= c._count.slots %></td>
            <td><%= c.isActive ? "Sim" : "Não" %></td>
            <td><a href="/admin/clinicas/<%= c.id %>">Editar →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('partials/footer') %>
