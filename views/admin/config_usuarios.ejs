<%- include('partials/header', { tituloPagina: "Usuários e permissões" }) %>
<%
  var base = "/admin/clinicas/" + t.id + "/config/usuarios";
  var eu = typeof usuario !== "undefined" && usuario ? usuario.userId : null;
%>

<div class="page-head">
  <div>
    <h1>Usuários e permissões</h1>
    <p class="muted" style="margin:4px 0 0">
      Quem acessa o painel desta clínica. Todos entram com o mesmo nível — veem
      só os dados da <%= t.name %>.
    </p>
  </div>
</div>

<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>

<div class="card">
  <div class="card-head">
    <h2>Acessos</h2>
    <span class="muted"><%= usuarios.length %> usuário<%= usuarios.length === 1 ? "" : "s" %></span>
  </div>

  <% if (usuarios.length === 0) { %>
    <div class="empty">Nenhum usuário ainda. Crie o primeiro no formulário abaixo.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Nome</th><th>E-mail</th><th>Último acesso</th><th>Situação</th><th></th></tr>
        </thead>
        <tbody>
          <% usuarios.forEach(function(u){ var souEu = eu && eu === u.id; %>
            <tr>
              <td>
                <%= u.name %>
                <% if (souEu) { %><span class="muted" style="font-size:11.5px"> · você</span><% } %>
              </td>
              <td><%= u.email %></td>
              <td class="muted"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString("pt-BR") : "nunca" %></td>
              <td>
                <span class="st <%= u.isActive ? 'st-confirmado' : 'st-cancelado' %>">
                  <%= u.isActive ? "Ativo" : "Desativado" %>
                </span>
              </td>
              <td class="num">
                <% if (souEu) { %>
                  <span class="muted" style="font-size:11.5px">sem ações no próprio acesso</span>
                <% } else { %>
                  <div class="row tight" style="justify-content:flex-end">
                    <form method="post" action="<%= base %>/<%= u.id %>/ativo">
                      <input type="hidden" name="ativar" value="<%= u.isActive ? '' : 'on' %>" />
                      <button class="btn sm ghost"><%= u.isActive ? "Desativar" : "Reativar" %></button>
                    </form>
                    <form method="post" action="<%= base %>/<%= u.id %>/excluir"
                          onsubmit="return confirm('Remover o acesso de <%= u.name %>?')">
                      <button class="btn sm danger">Remover</button>
                    </form>
                  </div>
                <% } %>
              </td>
            </tr>
            <tr>
              <td colspan="5" style="padding-top:0">
                <form method="post" action="<%= base %>/<%= u.id %>/senha" class="inline">
                  <label style="margin:0">Nova senha para <%= u.name %>
                    <input type="password" name="senha" minlength="8" required
                           placeholder="ao menos 8 caracteres" />
                  </label>
                  <button class="btn sm ghost">Redefinir senha</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<form method="post" action="<%= base %>" class="card">
  <div class="card-head"><h2>Novo usuário</h2></div>
  <div class="grid3">
    <label>Nome<input name="nome" required /></label>
    <label>E-mail<input type="email" name="email" required /></label>
    <label>Senha<input type="password" name="senha" minlength="8" required />
      <small>Ao menos 8 caracteres.</small>
    </label>
  </div>
  <p class="muted" style="margin:8px 0 0">
    O acesso fica preso a esta clínica — não há como criar administrador da
    plataforma por aqui.
  </p>
  <div style="margin-top:12px"><button class="btn">Criar usuário</button></div>
</form>

<%- include('partials/footer') %>
