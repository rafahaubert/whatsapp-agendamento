<!doctype html>
<html lang="pt-BR">
<%- include('head') %>
<body>
<%
  // Barra de contexto: diz onde você está. A navegação em si mora no rail à
  // esquerda; aqui fica só a clínica em foco e o nome da página.
  var ctxT = typeof t !== "undefined" && t ? t : null;
  var ctxTitulo = typeof tituloPagina !== "undefined" && tituloPagina ? tituloPagina : "";
  // clinica.ejs passa o próprio nome da clínica como título — na barra isso
  // apareceria duplicado, então a página vira "Configuração".
  if (ctxT && ctxTitulo === ctxT.name) ctxTitulo = "Configuração";
  var ctxSigla = ctxT
    ? ctxT.name.trim().split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0).toUpperCase(); }).join("")
    : "";
%>
  <div class="shell">
    <%- include('rail') %>

    <div class="shell-main">
      <header class="ctxbar">
        <button type="button" class="icon-btn rail-abrir" id="btnRailMobile"
                aria-controls="rail" aria-expanded="false" aria-label="Abrir menu">
          <%- include('icone', { nome: "menu" }) %>
        </button>

        <% if (ctxT) { %>
          <a class="ctx-clinica" href="/admin/clinicas/<%= ctxT.id %>">
            <span class="ctx-sigla" aria-hidden="true"><%= ctxSigla %></span>
            <span class="ctx-nome"><%= ctxT.name %></span>
          </a>
          <% if (typeof ehSuper !== "undefined" && ehSuper) { %>
            <a class="ctx-trocar" href="/admin">Trocar</a>
          <% } %>
        <% } else { %>
          <span class="ctx-clinica ctx-estatica"><span class="ctx-nome">Painel</span></span>
        <% } %>

        <% if (ctxTitulo) { %>
          <span class="ctx-pagina"><span aria-hidden="true">/</span> <%= ctxTitulo %></span>
        <% } %>
      </header>

      <main class="container">
