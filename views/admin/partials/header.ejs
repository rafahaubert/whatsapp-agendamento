<!doctype html>
<html lang="pt-BR">
<%- include('head') %>
<body>
  <header class="topbar">
    <a href="/admin" class="brand" aria-label="Haubert Agents — início">
      <%- include('marca', { marcaVariante: "topo" }) %>
    </a>

    <nav class="topnav">
      <% var caminho = typeof caminhoAtual !== "undefined" && caminhoAtual ? caminhoAtual : ""; %>
      <% if (typeof ehSuper !== "undefined" && ehSuper) { %>
        <a href="/admin" <%= /^\/admin\/?$|^\/admin\/clinicas/.test(caminho) ? 'aria-current="page"' : "" %>>Clínicas</a>
        <a href="/admin/usuarios" <%= caminho.indexOf("/admin/usuarios") === 0 ? 'aria-current="page"' : "" %>>Usuários</a>
      <% } %>
    </nav>

    <div class="topbar-end">
      <button type="button" class="icon-btn" id="btnTema" title="Alternar tema claro/escuro" aria-label="Alternar tema claro/escuro">
        <!-- Cada ícone mostra o tema para o qual o botão leva: lua = ir para o
             escuro (visível no claro); sol = ir para o claro (visível no escuro). -->
        <svg class="tema-escuro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="tema-claro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <% if (typeof usuario !== "undefined" && usuario && usuario.nome) { %>
        <span class="whoami">
          <span class="avatar" aria-hidden="true"><%= usuario.nome.trim().charAt(0).toUpperCase() %></span>
          <span class="nome"><%= usuario.nome %></span>
        </span>
      <% } %>
      <form method="post" action="/admin/logout"><button class="link">Sair</button></form>
    </div>
  </header>

  <script>
    // Alterna claro/escuro e guarda a escolha; sem preferência salva, segue o sistema.
    document.getElementById("btnTema").addEventListener("click", function () {
      var raiz = document.documentElement;
      var atual = raiz.getAttribute("data-theme");
      if (!atual) {
        atual = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      var novo = atual === "dark" ? "light" : "dark";
      raiz.setAttribute("data-theme", novo);
      try { localStorage.setItem("ha-tema", novo); } catch (e) {}
    });
  </script>

  <main class="container">
