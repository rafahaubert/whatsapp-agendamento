<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof tituloPagina !== "undefined" && tituloPagina ? tituloPagina + " · " : "" %>Haubert Agents</title>
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#163029" />
  <meta name="color-scheme" content="light dark" />
  <script>
    // Aplica tema e estado do menu ANTES da primeira pintura — sem piscar branco
    // no modo escuro e sem o rail saltar de 68px para 212px ao carregar.
    (function () {
      try {
        var t = localStorage.getItem("ha-tema");
        if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        if (localStorage.getItem("ha-rail") === "fixo") {
          document.documentElement.setAttribute("data-rail", "fixo");
        }
      } catch (e) {}
    })();
  </script>
  <style>
    /* ==========================================================================
       Haubert Agents — sistema visual do painel
       Paleta da marca: verde profundo #163029 · sálvia #41695B · névoa #C8C8C8
       Os tokens de status (info/bom/atenção/crítico) foram medidos contra as
       superfícies reais dos dois temas; todos passam 4:1 de contraste. Como
       vermelho×âmbar e vermelho×verde colidem sob daltonismo, todo status
       carrega SEMPRE glifo + rótulo — a cor nunca é o único canal.
       ========================================================================== */
    :root{
      color-scheme: light;

      /* --- marca (invariante nos dois temas) --- */
      --ha-deep:#163029; --ha-sage:#41695b; --ha-mist:#c8c8c8;

      /* --- superfícies --- */
      --plane:#f1f5f3;        /* fundo da página */
      --card:#ffffff;         /* superfície dos cartões */
      --card-2:#f6f9f7;       /* superfície recuada (cabeçalhos de tabela, tracks) */
      --line:#dee7e3;         /* hairline */
      --line-2:#c8d8d1;       /* hairline forte */

      /* --- tinta --- */
      --ink:#0f211c;
      --ink-2:#4a5f58;
      --muted:#5f736d;

      /* --- ação --- */
      --brand:#163029;        /* fundo de botão primário / chrome */
      --brand-ink:#ffffff;    /* tinta sobre --brand */
      --accent:#41695b;
      --link:#245647;
      --ring:rgba(65,105,91,.28);

      /* --- status (glifo + rótulo obrigatórios) --- */
      --info:#2e6da4; --ok:#12794a; --warn:#9d7000; --danger:#c23b46;
      --ev-ink:#ffffff;        /* tinta sobre preenchimento de status */

      /* --- rampa sequencial da marca (medidores) --- */
      --ramp-1:#8fb5a6; --ramp-2:#5e8c7b; --ramp-3:#41695b; --ramp-4:#2a4c40;
      --track:#e4ede9;

      /* --- elevação e forma --- */
      --shadow:0 1px 2px rgba(15,33,28,.05), 0 1px 3px rgba(15,33,28,.06);
      --shadow-2:0 8px 28px rgba(15,33,28,.14);
      --r:10px; --r-sm:8px; --r-xs:6px;
    }

    @media (prefers-color-scheme: dark){
      :root:where(:not([data-theme="light"])){
        color-scheme: dark;
        --plane:#0f1f1b; --card:#16302a; --card-2:#1c3a32;
        --line:#27473d; --line-2:#33594d;
        --ink:#e8efec; --ink-2:#a9bfb8; --muted:#839c94;
        --brand:#c8dcd4; --brand-ink:#0f211c;
        --accent:#a9c9bd; --link:#9cc5b5; --ring:rgba(169,201,189,.30);
        --info:#7fb3e0; --ok:#3fba86; --warn:#d2a83c; --danger:#e77a7a;
        --ev-ink:#0f211c;
        --ramp-1:#a5c4b8; --ramp-2:#7fa899; --ramp-3:#5e8c7b; --ramp-4:#41695b;
        --track:#22423a;
        --shadow:0 1px 2px rgba(0,0,0,.30), 0 1px 3px rgba(0,0,0,.24);
        --shadow-2:0 10px 34px rgba(0,0,0,.45);
      }
    }
    :root[data-theme="dark"]{
      color-scheme: dark;
      --plane:#0f1f1b; --card:#16302a; --card-2:#1c3a32;
      --line:#27473d; --line-2:#33594d;
      --ink:#e8efec; --ink-2:#a9bfb8; --muted:#839c94;
      --brand:#c8dcd4; --brand-ink:#0f211c;
      --accent:#a9c9bd; --link:#9cc5b5; --ring:rgba(169,201,189,.30);
      --info:#7fb3e0; --ok:#3fba86; --warn:#d2a83c; --danger:#e77a7a;
      --ev-ink:#0f211c;
      --ramp-1:#a5c4b8; --ramp-2:#7fa899; --ramp-3:#5e8c7b; --ramp-4:#41695b;
      --track:#22423a;
      --shadow:0 1px 2px rgba(0,0,0,.30), 0 1px 3px rgba(0,0,0,.24);
      --shadow-2:0 10px 34px rgba(0,0,0,.45);
    }

    *{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%}
    body{
      margin:0;
      font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      background:var(--plane);color:var(--ink);
      -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
    }
    a{color:var(--link);text-decoration:none}
    a:hover{text-decoration:underline}
    :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
    ::selection{background:color-mix(in srgb,var(--accent) 30%,transparent)}

    /* ------------------------------------------- barra do topo (página pública) */
    /* Só `privacidade.ejs` ainda usa esta barra; o painel navega pelo rail. */
    .topbar{
      position:sticky;top:0;z-index:40;
      display:flex;align-items:center;gap:14px;
      background:var(--ha-deep);color:#fff;
      padding:0 20px;height:52px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }
    .topbar a{color:#fff}
    .brand{display:flex;align-items:center;gap:10px;flex:0 0 auto;height:100%}
    .brand:hover{text-decoration:none;opacity:.88}
    .brand .mark{width:24px;height:24px;flex:0 0 auto;color:var(--ha-mist)}
    .brand .mark svg{width:100%;height:100%;display:block}
    .brand .word{display:flex;align-items:baseline;gap:7px}
    .brand .word svg{display:block;height:13px;width:auto}
    .brand .word .w-haubert{color:#fff}
    .brand .word .w-agents{color:var(--ha-mist);opacity:.85}
    .brand .word .w-agents svg{height:11px}
    @media (max-width:900px){.brand .word .w-agents{display:none}}
    @media (max-width:640px){
      .topbar{gap:8px;padding:0 12px}
      .brand .word{display:none}
    }

    /* ============================================================== o esqueleto
       Rail fixo à esquerda + coluna de conteúdo. O rail é `fixed` de propósito:
       ao expandir (hover) ele passa POR CIMA do conteúdo, sem reflow. Fixado,
       aí sim empurra — é uma escolha deliberada do usuário, não um acidente do
       ponteiro. A barra de contexto tem 52px, a mesma altura da antiga barra do
       topo, para `.tabs{top:52px}` e o scrollspy da clínica seguirem válidos.
       ========================================================================= */
    .shell{display:flex;min-height:100vh}
    .shell-main{flex:1;min-width:0;margin-left:68px;transition:margin-left .14s}
    :root[data-rail="fixo"] .shell-main{margin-left:236px}

    /* ------------------------------------------------------------------- rail */
    .rail{
      position:fixed;left:0;top:0;bottom:0;z-index:50;
      width:68px;transition:width .14s;
      background:var(--ha-deep);color:#fff;
      display:flex;flex-direction:column;
      padding:12px 10px 14px;overflow:visible;
      /* No tema escuro o fundo da página chega perto do verde do rail; o filete
         mantém a borda legível sem introduzir cor nova. */
      border-right:1px solid rgba(255,255,255,.08);
    }
    .rail:hover,.rail:focus-within,
    :root[data-rail="fixo"] .rail{width:236px;box-shadow:var(--shadow-2)}

    .rail-marca{display:flex;align-items:center;gap:10px;padding:0 5px;margin-bottom:12px;min-height:32px}
    .rail-marca:hover{text-decoration:none;opacity:.88}
    .rail-marca .mark{width:28px;height:28px;flex:0 0 auto;color:var(--ha-mist)}
    .rail-marca .mark svg{width:100%;height:100%;display:block}
    .rail-marca-nome{font-size:13px;font-weight:640;color:#fff;letter-spacing:.01em}

    .rail-nav{display:flex;flex-direction:column;gap:2px;flex:1;min-height:0;overflow-y:auto;scrollbar-width:none}
    .rail-nav::-webkit-scrollbar{display:none}
    .rail-fim{display:flex;flex-direction:column;gap:2px;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.14)}
    .rail-fim form{margin:0}

    /* `--rail-lbl` é o interruptor único do estado aberto/fechado: os rótulos
       de item leem essa variável em vez de repetir os três seletores de
       expansão (hover, foco dentro, fixado). */
    .rail{--rail-lbl:none}
    .rail:hover,.rail:focus-within,:root[data-rail="fixo"] .rail{--rail-lbl:block}

    /* O nav é flex column e rola quando o menu não cabe. Sem isto os itens
       encolhem em vez de rolar — com o menu cheio, os rótulos de grupo chegaram
       a 1px de altura e sumiram da tela. */
    .rail-nav > *{flex:0 0 auto}

    .rail-grp{
      font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
      margin:10px 0 3px;padding:0 8px;
      white-space:nowrap;overflow:hidden;
      /* Fechado o texto some, mas a linha fica: é ela que separa os dois grupos. */
      color:transparent;
    }
    .rail:hover .rail-grp,.rail:focus-within .rail-grp,
    :root[data-rail="fixo"] .rail-grp{color:rgba(255,255,255,.42)}

    .rail-i{
      position:relative;display:flex;align-items:center;gap:11px;
      width:100%;padding:8px;border:0;border-radius:10px;
      background:transparent;color:rgba(255,255,255,.66);
      font:inherit;font-size:13px;text-align:left;cursor:pointer;
    }
    .rail-i:hover{background:rgba(255,255,255,.10);color:#fff;text-decoration:none}
    .rail-i[aria-current="page"]{background:var(--ha-sage);color:#fff;font-weight:560}
    .rail-i[aria-pressed="true"]{color:#fff}
    .rail-eu{cursor:default}
    .rail-eu:hover{background:transparent;color:rgba(255,255,255,.66)}

    .rail-ico{position:relative;display:grid;place-items:center;width:24px;height:24px;flex:0 0 auto}
    /* Sem `display` aqui: as regras de tema lá embaixo é que decidem se o sol ou
       a lua aparece, e `.rail-ico svg` venceria por especificidade. */
    .rail-ico svg{width:20px;height:20px}
    .rail-lbl{display:var(--rail-lbl);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rail-i .avatar{width:24px;height:24px}

    .rail-badge{
      position:absolute;top:-5px;right:-7px;
      min-width:17px;height:17px;padding:0 4px;border-radius:999px;
      background:var(--danger);color:#fff;border:2px solid var(--ha-deep);
      font-size:10px;font-weight:700;line-height:13px;text-align:center;
    }
    /* Expandido o número mora ao lado do rótulo — no ícone ele brigaria com o texto. */
    .rail:hover .rail-badge,.rail:focus-within .rail-badge,
    :root[data-rail="fixo"] .rail-badge{display:none}
    /* Fora do `.rail-lbl`: lá dentro o ellipsis do rótulo comeria o número. */
    .rail-cnt{
      display:var(--rail-lbl);flex:0 0 auto;
      background:var(--danger);color:#fff;border-radius:999px;
      padding:1px 7px;font-size:10.5px;font-weight:700;line-height:1.5;
    }

    /* --------------------------------------------------- submenu (<details>) */
    /* `<details>` em vez de JS: abre e fecha sozinho, é navegável por teclado e
       sobrevive a página sem script. O servidor já manda `open` quando a tela
       atual está dentro do grupo. */
    .rail-sub{margin-top:10px;display:flex;flex-direction:column;gap:2px}
    /* Fechado, o pai é a única pista de onde você está — daí o mesmo destaque
       dos outros itens. Aberto, ele convive com o filho ativo. */
    .rail-i-dentro{background:var(--ha-sage);color:#fff}
    .rail-filho{
      display:var(--rail-lbl);
      padding:6px 8px 6px 43px;font-size:12.5px;
      color:rgba(255,255,255,.58);
    }
    .rail-filho:hover{color:#fff}
    .rail-filho[aria-current="page"]{background:rgba(255,255,255,.14);color:#fff;font-weight:560}
    /* Sem tooltip próprio: apontar para um ícone já expande o rail e revela o
       rótulo. O `title` de cada item cobre o instante anterior à expansão, e o
       `aria-label` cobre quem navega por leitor de tela. */

    .rail-fundo{
      position:fixed;inset:0;z-index:45;
      background:color-mix(in srgb,var(--ha-deep) 55%,transparent);
    }

    /* ------------------------------------------------- barra de contexto (52px) */
    .ctxbar{
      position:sticky;top:0;z-index:30;
      display:flex;align-items:center;gap:10px;
      height:52px;padding:0 20px;
      background:var(--card);border-bottom:1px solid var(--line);
    }
    .ctx-clinica{
      display:flex;align-items:center;gap:8px;min-width:0;
      border:1px solid var(--line-2);border-radius:999px;
      padding:4px 12px 4px 5px;background:var(--card-2);color:var(--ink);
      font-size:13px;font-weight:560;
    }
    a.ctx-clinica:hover{border-color:var(--accent);text-decoration:none}
    .ctx-estatica{padding-left:12px;cursor:default}
    .ctx-sigla{
      width:22px;height:22px;border-radius:50%;flex:0 0 auto;
      display:grid;place-items:center;background:var(--ha-sage);color:#fff;
      font-size:10px;font-weight:700;letter-spacing:.02em;
    }
    .ctx-nome{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ctx-trocar{font-size:12px;color:var(--muted)}
    .ctx-pagina{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    /* O ☰ só existe na largura de gaveta. Precisa do `.ctxbar` na frente para
       ganhar de `.icon-btn{display:grid}`, que é declarado logo abaixo. */
    .ctxbar .rail-abrir{display:none}

    .icon-btn{
      display:grid;place-items:center;width:32px;height:32px;padding:0;flex:0 0 auto;
      background:var(--card);border:1px solid var(--line-2);border-radius:var(--r-sm);
      color:var(--ink-2);cursor:pointer;font-size:14px;line-height:1;
    }
    .icon-btn:hover{background:var(--card-2);color:var(--ink)}
    /* Sem `display` aqui: as regras de tema abaixo é que decidem qual ícone
       aparece, e `.icon-btn svg` venceria por especificidade. */
    .icon-btn svg{width:17px;height:17px}
    .tema-claro,.tema-escuro{display:none}
    :root[data-theme="dark"] .tema-claro{display:block}
    :root:not([data-theme]) .tema-escuro{display:block}
    :root[data-theme="light"] .tema-escuro{display:block}
    @media (prefers-color-scheme: dark){
      :root:not([data-theme]) .tema-escuro{display:none}
      :root:not([data-theme]) .tema-claro{display:block}
    }
    .link{
      background:none;border:0;color:var(--link);cursor:pointer;
      font:inherit;font-size:13px;padding:6px 8px;border-radius:var(--r-sm);
    }
    .link:hover{background:var(--card-2)}

    /* Abaixo de 900px o rail vira gaveta: sai da frente e volta pelo botão ☰. */
    @media (max-width:900px){
      .shell-main,:root[data-rail="fixo"] .shell-main{margin-left:0}
      .rail,.rail:hover,.rail:focus-within,:root[data-rail="fixo"] .rail{
        width:236px;transform:translateX(-100%);transition:transform .16s;box-shadow:none;
      }
      .rail{--rail-lbl:block}
      .rail-grp,.rail:hover .rail-grp{color:rgba(255,255,255,.42)}
      .rail-badge{display:none}
      :root[data-rail-mobile="aberto"] .rail{transform:none;box-shadow:var(--shadow-2)}
      .ctxbar .rail-abrir{display:grid}
      .rail-fixar{display:none}
    }
    @media (min-width:901px){.rail-fundo{display:none}}

    /* ------------------------------------------------------------- container */
    .container{max-width:1240px;margin:0 auto;padding:18px 20px 48px}
    @media (max-width:640px){.container{padding:14px 14px 36px}.ctxbar{padding:0 14px}}

    /* ---------------------------------------------------- cabeçalho de página */
    .page-head{
      display:flex;align-items:flex-end;justify-content:space-between;
      gap:12px;flex-wrap:wrap;margin:0 0 14px;
    }
    .page-head h1{margin:0}
    .eyebrow{
      display:flex;align-items:center;gap:6px;
      font-size:12px;color:var(--muted);margin:0 0 3px;
    }
    .eyebrow a{color:var(--muted)}
    .eyebrow a:hover{color:var(--ink)}

    h1{font-size:20px;font-weight:650;letter-spacing:-.015em;line-height:1.25;margin:0}
    h2{
      font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
      color:var(--muted);margin:20px 0 8px;
    }
    h2:first-child{margin-top:0}
    h3{font-size:14px;font-weight:600;margin:14px 0 6px}

    /* ---------------------------------------------------------------- cartão */
    .card{
      background:var(--card);border:1px solid var(--line);border-radius:var(--r);
      padding:14px 16px;margin:12px 0;box-shadow:var(--shadow);
    }
    .card + .card{margin-top:12px}
    .card > h2:first-child{margin-top:0}
    .card-head{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      flex-wrap:wrap;margin:-14px -16px 12px;padding:10px 16px;
      border-bottom:1px solid var(--line);background:var(--card-2);
      border-radius:var(--r) var(--r) 0 0;
    }
    .card-head h2{margin:0}
    .card-head .muted{font-size:12px}

    /* ------------------------------------------------------------------ abas */
    .tabs{
      position:sticky;top:52px;z-index:20;
      display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;
      background:var(--plane);padding:8px 0;margin:0 0 4px;
      border-bottom:1px solid var(--line);
    }
    .tabs::-webkit-scrollbar{display:none}
    .tabs a{
      padding:6px 11px;border-radius:999px;color:var(--ink-2);
      font-size:13px;font-weight:500;white-space:nowrap;
    }
    .tabs a:hover{background:var(--card);color:var(--ink);text-decoration:none}
    .tabs a.on{background:var(--ink);color:var(--plane)}
    .tabs .sep{width:1px;background:var(--line);margin:4px 6px;flex:0 0 auto}

    /* --------------------------------------------------------------- layouts */
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .row.tight{gap:6px}
    .between{justify-content:space-between}
    .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:10px 14px}
    .grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 14px}
    .spacer{flex:1}

    /* --------------------------------------------------------- KPI / métricas */
    .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
    .kpi{
      background:var(--card);border:1px solid var(--line);border-radius:var(--r);
      padding:12px 14px;box-shadow:var(--shadow);
      display:flex;flex-direction:column;gap:5px;min-width:0;
    }
    .kpi .rot{
      font-size:12px;color:var(--muted);line-height:1.3;
      display:flex;align-items:center;gap:5px;
    }
    .kpi .val{
      font-size:28px;font-weight:650;line-height:1.05;letter-spacing:-.02em;
      color:var(--ink);           /* o número usa tinta; a cor vive na barra abaixo */
    }
    .kpi .val.sm{font-size:22px}
    .kpi .sub{font-size:12px;color:var(--muted);line-height:1.35}
    .kpi .sub b{color:var(--ink-2);font-weight:600}
    .kpi.hero{grid-column:span 2}
    .kpi.hero .val{font-size:44px}
    @media (max-width:560px){.kpi.hero{grid-column:span 1}.kpi.hero .val{font-size:34px}}

    /* Medidor: trilha = passo claro da mesma rampa; o preenchimento carrega a
       severidade. As classes levam o prefixo m-/seg- de propósito: `.ok` e
       `.erro` já são os avisos da página, e reaproveitá-las aqui herdaria
       padding, borda e o glifo ::before do aviso. */
    .meter{display:block;height:5px;border-radius:999px;background:var(--track);overflow:hidden;margin-top:1px}
    .meter > i{display:block;height:100%;border-radius:999px;background:var(--ramp-3)}
    .meter.m-ok > i{background:var(--ok)}
    .meter.m-warn > i{background:var(--warn)}
    .meter.m-danger > i{background:var(--danger)}
    .meter.m-info > i{background:var(--info)}

    /* Barra de composição: separador de 2px na cor da superfície entre segmentos. */
    .split{display:flex;height:6px;border-radius:999px;overflow:hidden;background:var(--track);gap:2px}
    .split > i{display:block;height:100%;padding:0;border:0}
    .split > i.seg-ok{background:var(--ok)}
    .split > i.seg-danger{background:var(--danger)}
    .split > i.seg-muted{background:var(--ramp-1)}
    .legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:6px}
    .legend span{display:inline-flex;align-items:center;gap:5px;padding:0;border:0}
    .legend span::before{content:none}
    .legend i{width:8px;height:8px;border-radius:2px;flex:0 0 auto;padding:0;border:0}
    .legend i.seg-ok{background:var(--ok)}
    .legend i.seg-danger{background:var(--danger)}
    .legend i.seg-muted{background:var(--ramp-1)}

    /* ------------------------------------------------------------ formulários */
    label{display:block;margin:8px 0;font-size:12px;font-weight:500;color:var(--muted)}
    label small{display:block;font-weight:400;margin-top:3px;color:var(--muted);opacity:.9}
    input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]),
    textarea,select{
      width:100%;padding:7px 10px;margin-top:4px;
      border:1px solid var(--line-2);border-radius:var(--r-sm);
      font:inherit;font-size:13.5px;background:var(--card);color:var(--ink);color-scheme:inherit;
      transition:border-color .12s, box-shadow .12s;
    }
    input::placeholder,textarea::placeholder{color:var(--muted);opacity:.7}
    input[type=datetime-local],input[type=date],input[type=time]{min-height:34px}
    input[type=datetime-local]::-webkit-calendar-picker-indicator,
    input[type=date]::-webkit-calendar-picker-indicator,
    input[type=time]::-webkit-calendar-picker-indicator{opacity:.55;cursor:pointer}
    :root[data-theme="dark"] input::-webkit-calendar-picker-indicator{filter:invert(1);opacity:.6}
    @media (prefers-color-scheme: dark){
      :root:where(:not([data-theme="light"])) input::-webkit-calendar-picker-indicator{filter:invert(1);opacity:.6}
    }
    input:focus,textarea:focus,select:focus{
      outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--ring);
    }
    textarea{min-height:62px;resize:vertical;line-height:1.45}

    .inline{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
    .inline > *{flex:1;min-width:120px}

    /* Busca do cabeçalho de página (pacientes). O seletor global de input acima
       carrega quatro `:not()` e venceria qualquer `.busca input`, forçando
       width:100% — daí a cadeia repetida aqui para poder dimensionar o campo. */
    .busca{display:flex;gap:6px;align-items:center}
    .busca input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]){
      width:250px;margin-top:0;
    }
    @media (max-width:560px){
      .busca{width:100%}
      .busca input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]){
        width:auto;flex:1;min-width:0;
      }
    }
    .inline .btn{flex:0 0 auto;min-width:0}
    .inline label{margin:0}

    .checks{display:flex;gap:8px 16px;flex-wrap:wrap;margin:6px 0}
    .checks label{
      display:flex;align-items:center;gap:7px;color:var(--ink-2);
      margin:0;font-size:13px;font-weight:500;cursor:pointer;
    }
    .checks input{width:auto;margin:0;accent-color:var(--accent)}
    /* Nas tabelas de horário a classe cai num <td>: flex quebraria a célula. */
    td.checks{display:table-cell;text-align:center;margin:0}
    /* Caixa de seleção própria: o desenho nativo no tema escuro herda um tom
       arroxeado do accent-color e destoa da paleta. */
    input[type=checkbox]{
      appearance:none;-webkit-appearance:none;
      width:15px;height:15px;margin:0;flex:0 0 auto;vertical-align:-2px;
      border:1.5px solid var(--line-2);border-radius:4px;background:var(--card);
      display:inline-grid;place-content:center;cursor:pointer;
      transition:background .12s,border-color .12s;
    }
    input[type=checkbox]:hover{border-color:var(--accent)}
    input[type=checkbox]::before{
      content:"";width:9px;height:9px;transform:scale(0);transition:transform .1s;
      background:var(--brand-ink);
      clip-path:polygon(14% 44%,0 65%,50% 100%,100% 16%,80% 0,43% 62%);
    }
    input[type=checkbox]:checked{background:var(--accent);border-color:var(--accent)}
    input[type=checkbox]:checked::before{transform:scale(1)}

    fieldset{border:1px solid var(--line);border-radius:var(--r-sm);margin:10px 0;padding:10px 12px}
    legend{
      color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase;
      letter-spacing:.06em;padding:0 5px;
    }

    /* ---------------------------------------------------------------- botões */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:6px;
      background:var(--brand);color:var(--brand-ink);border:1px solid transparent;
      border-radius:var(--r-sm);padding:8px 14px;
      font:inherit;font-size:13px;font-weight:600;line-height:1.2;
      cursor:pointer;white-space:nowrap;transition:filter .12s, background .12s, border-color .12s;
    }
    .btn:hover{filter:brightness(1.12);text-decoration:none}
    :root[data-theme="dark"] .btn:hover{filter:brightness(.94)}
    .btn:active{transform:translateY(.5px)}
    .btn.sm{padding:5px 10px;font-size:12.5px;border-radius:var(--r-xs)}
    .btn.ghost{background:var(--card);color:var(--ink);border-color:var(--line-2);font-weight:500}
    .btn.ghost:hover{background:var(--card-2);border-color:var(--accent);color:var(--accent);filter:none}
    .btn.danger{background:transparent;color:var(--danger);border-color:color-mix(in srgb,var(--danger) 45%,transparent);font-weight:500}
    .btn.danger:hover{background:var(--danger);color:#fff;filter:none;border-color:var(--danger)}
    :root[data-theme="dark"] .btn.danger:hover{color:#16302a}

    /* --------------------------------------------------------------- tabelas */
    .table-wrap{overflow-x:auto;margin:0 -16px;padding:0 16px}
    table{width:100%;border-collapse:collapse}
    th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
    td{font-size:13.5px}
    th{
      color:var(--muted);font-weight:700;font-size:11px;
      text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;
      border-bottom-color:var(--line-2);
    }
    tbody tr:last-child td{border-bottom:0}
    tbody tr:hover td{background:var(--card-2)}
    td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
    td.acoes{text-align:right;white-space:nowrap}
    td.acoes .inline{justify-content:flex-end}
    table .muted{font-size:12.5px}

    /* -------------------------------------------------------- chips e status */
    .pill{
      display:inline-flex;align-items:center;gap:4px;
      background:var(--card-2);border:1px solid var(--line);
      border-radius:999px;padding:2px 9px;font-size:12px;color:var(--ink-2);margin:2px 3px 2px 0;
    }
    .pill.on{border-color:color-mix(in srgb,var(--accent) 50%,transparent);background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
    .pill .link{color:var(--danger);padding:0 0 0 2px;font-size:13px;line-height:1}
    .pill .link:hover{background:none;color:var(--danger);text-decoration:underline}

    .badge{
      display:inline-flex;align-items:center;gap:5px;
      font-size:11.5px;font-weight:600;padding:2px 9px;border-radius:999px;white-space:nowrap;
    }
    .badge.on{border:1px solid color-mix(in srgb,var(--ok) 45%,transparent);color:var(--ok);background:color-mix(in srgb,var(--ok) 10%,transparent)}
    .badge.off{border:1px solid var(--line-2);color:var(--muted)}

    /* Status: glifo + rótulo sempre juntos — a cor nunca é o único canal. */
    .st{
      display:inline-flex;align-items:center;gap:5px;
      font-size:11.5px;font-weight:600;padding:2px 9px;border-radius:999px;white-space:nowrap;
    }
    .st::before{font-size:10px;line-height:1;font-weight:700}
    .st-agendado{color:var(--info);background:color-mix(in srgb,var(--info) 12%,transparent)}
    .st-agendado::before{content:"●"}
    .st-confirmado{color:var(--ok);background:color-mix(in srgb,var(--ok) 12%,transparent)}
    .st-confirmado::before{content:"✓"}
    .st-remarcado{color:var(--warn);background:color-mix(in srgb,var(--warn) 14%,transparent)}
    .st-remarcado::before{content:"↻"}
    .st-cancelado{color:var(--muted);background:color-mix(in srgb,var(--muted) 14%,transparent)}
    .st-cancelado::before{content:"×"}
    .st-faltou{color:var(--danger);background:color-mix(in srgb,var(--danger) 12%,transparent)}
    .st-faltou::before{content:"!"}

    /* --------------------------------------------------------------- avisos */
    .ok,.erro{
      display:flex;align-items:flex-start;gap:8px;
      padding:9px 12px;border-radius:var(--r-sm);font-size:13px;margin:0 0 12px;border:1px solid;
    }
    .ok{border-color:color-mix(in srgb,var(--ok) 40%,transparent);color:var(--ok);background:color-mix(in srgb,var(--ok) 8%,transparent)}
    .ok::before{content:"✓";font-weight:700}
    .erro{border-color:color-mix(in srgb,var(--danger) 40%,transparent);color:var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent)}
    .erro::before{content:"!";font-weight:700}
    .muted{color:var(--muted);font-size:12.5px}
    p.muted{margin:6px 0}
    .empty{
      text-align:center;color:var(--muted);font-size:13px;
      padding:22px 16px;border:1px dashed var(--line-2);border-radius:var(--r-sm);
    }
    code{
      background:var(--card-2);border:1px solid var(--line);border-radius:4px;
      padding:1px 5px;font-size:12.5px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    }
    details > summary{cursor:pointer;color:var(--muted);font-size:12.5px;list-style:none}
    details > summary::-webkit-details-marker{display:none}
    details > summary::before{content:"▸ ";display:inline-block;transition:transform .15s}
    details[open] > summary::before{content:"▾ "}
    details > summary:hover{color:var(--ink)}

    /* ----------------------------------------------------------------- login */
    .login-wrap{
      min-height:100vh;display:grid;place-items:center;padding:20px;
      background:
        radial-gradient(120% 90% at 50% -10%, color-mix(in srgb,var(--ha-sage) 22%,transparent), transparent 60%),
        var(--plane);
    }
    .login{width:100%;max-width:352px;margin:0;padding:26px 24px}
    .login .brand-block{display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:20px}
    .login .brand-block .mark{width:44px;height:44px;color:var(--ha-deep)}
    :root[data-theme="dark"] .login .brand-block .mark{color:var(--ha-mist)}
    @media (prefers-color-scheme: dark){
      :root:where(:not([data-theme="light"])) .login .brand-block .mark{color:var(--ha-mist)}
    }
    .login .brand-block .mark svg{width:100%;height:100%;display:block}
    .login .brand-block .word{display:flex;align-items:baseline;gap:7px;color:var(--ink)}
    .login .brand-block .word svg{display:block;height:15px;width:auto}
    .login .brand-block .w-agents{color:var(--muted)}
    .login .brand-block .w-agents svg{height:13px}

    /* ----------------------------------------------------- caixa de entrada */
    .inbox{display:grid;grid-template-columns:296px 1fr;gap:12px;align-items:start}
    @media (max-width:820px){.inbox{grid-template-columns:1fr}}
    .conv-lista{padding:6px;max-height:70vh;overflow-y:auto}
    .conv{display:block;padding:7px 9px;border-radius:var(--r-sm);color:var(--ink);border:1px solid transparent}
    .conv:hover{background:var(--card-2);text-decoration:none}
    .conv.sel{background:color-mix(in srgb,var(--accent) 12%,transparent);border-color:color-mix(in srgb,var(--accent) 40%,transparent)}
    .conv-topo{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
    .conv-topo strong{font-size:13px;font-weight:600}
    .conv-hora{font-size:11px;color:var(--muted);white-space:nowrap}
    .conv-baixo{display:flex;align-items:center;gap:6px;margin-top:1px;min-width:0}
    .conv-previa{flex:1;min-width:0;font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .conv-baixo .st{flex:0 0 auto;font-size:10.5px;padding:1px 7px}
    .conv-flag{
      flex:0 0 auto;font-size:10px;font-weight:600;color:var(--muted);
      border:1px solid var(--line-2);border-radius:999px;padding:0 6px;
    }
    .thread{
      max-height:52vh;overflow-y:auto;display:flex;flex-direction:column;gap:5px;
      margin-top:12px;padding:10px;background:var(--card-2);border-radius:var(--r-sm);
    }
    .bolha{
      width:fit-content;max-width:min(64%,380px);padding:6px 9px 4px;border-radius:10px;
      font-size:13.5px;line-height:1.4;box-shadow:0 1px 1px rgba(15,33,28,.10);
    }
    .bolha .txt{white-space:pre-line;overflow-wrap:anywhere}
    .bolha.in{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-top-left-radius:3px}
    .bolha.out{
      align-self:flex-end;border-top-right-radius:3px;
      background:color-mix(in srgb,var(--accent) 20%,var(--card));
      border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);
    }
    .bolha .meta{font-size:10.5px;color:var(--muted);margin-top:2px;line-height:1.2;text-align:right;white-space:nowrap}
    @media (max-width:820px){.bolha{max-width:88%}}

    /* ------------------------------------------------- lista de clínicas */
    .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
    .cards .card{margin:0;transition:border-color .12s,box-shadow .12s,transform .12s}
    a.card{display:block;color:inherit}
    a.card:hover{border-color:var(--accent);box-shadow:var(--shadow-2);transform:translateY(-1px);text-decoration:none}
    .stat{display:flex;gap:18px;margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}
    .stat b{display:block;font-size:17px;font-weight:650;color:var(--ink);line-height:1.15}
    .stat span{font-size:11.5px;color:var(--muted)}

    /* --------------------------------------------------------------- modal */
    dialog{
      border:1px solid var(--line);border-radius:var(--r);background:var(--card);color:var(--ink);
      padding:20px;max-width:480px;width:92%;box-shadow:var(--shadow-2);
    }
    dialog::backdrop{background:color-mix(in srgb,var(--ha-deep) 60%,transparent);backdrop-filter:blur(2px)}
    dialog h2{font-size:14px;text-transform:none;letter-spacing:0;color:var(--ink);font-weight:650}

    /* -------------------------------------------- FullCalendar (calendário) */
    .fc{
      --fc-border-color:var(--line);--fc-page-bg-color:var(--card);--fc-neutral-bg-color:var(--card-2);
      --fc-today-bg-color:color-mix(in srgb,var(--accent) 9%,transparent);
      --fc-now-indicator-color:var(--danger);
      --fc-event-border-color:transparent;--fc-small-font-size:11.5px;
      --fc-list-event-hover-bg-color:var(--card-2);
    }
    .fc a{color:inherit;text-decoration:none}
    .fc .fc-list-event-title a,.fc .fc-list-event-time{color:var(--ink)}
    .fc .fc-list-event:hover td{background:var(--card-2)}
    .fc .fc-list-day-cushion{background:var(--card-2);color:var(--muted)}
    .fc .fc-list-empty{background:var(--card);color:var(--muted)}
    .fc .ev{overflow:hidden;line-height:1.25}
    .fc .ev-t{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc .ev-m{font-size:10.5px;opacity:.88;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc .fc-toolbar-title{font-size:16px;font-weight:650;letter-spacing:-.015em}
    .fc .fc-toolbar.fc-header-toolbar{margin-bottom:12px;gap:8px;flex-wrap:wrap}
    .fc .fc-button{
      background:var(--card);border:1px solid var(--line-2);color:var(--ink);
      font-weight:500;font-size:12.5px;padding:5px 10px;border-radius:var(--r-xs);
      box-shadow:none;text-transform:capitalize;
    }
    .fc .fc-button:hover{background:var(--card-2);border-color:var(--accent);color:var(--accent)}
    .fc .fc-button:focus{box-shadow:0 0 0 3px var(--ring)!important}
    .fc .fc-button-primary:not(:disabled).fc-button-active,
    .fc .fc-button-primary:not(:disabled):active{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
    .fc .fc-button-primary:disabled{background:var(--card);border-color:var(--line);color:var(--muted);opacity:.6}
    .fc .fc-col-header-cell{
      background:var(--card-2);padding:7px 2px;font-size:11px;font-weight:700;
      text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
    }
    .fc .fc-daygrid-day-number,.fc .fc-timegrid-slot-label-cushion{color:var(--muted);font-size:11.5px}
    .fc .fc-day-today .fc-daygrid-day-number{color:var(--accent);font-weight:700}
    .fc .fc-event{border-radius:5px;padding:1px 4px;font-size:11.5px;font-weight:500;cursor:pointer}
    .fc .fc-event:hover{filter:brightness(1.08)}
    /* Cor do evento por status, via classe — acompanha o tema (o servidor manda
       só a classe). --ev-ink é escolhido pela luminância do preenchimento. */
    .fc .fc-event.ev-agendado{background:var(--info);border-color:var(--info);color:var(--ev-ink)}
    .fc .fc-event.ev-confirmado{background:var(--ok);border-color:var(--ok);color:var(--ev-ink)}
    .fc .fc-event.ev-remarcado{background:var(--warn);border-color:var(--warn);color:var(--ev-ink)}
    .fc .fc-event.ev-cancelado{background:var(--muted);border-color:var(--muted);color:var(--ev-ink)}
    .fc .fc-event.ev-faltou{background:var(--danger);border-color:var(--danger);color:var(--ev-ink)}
    .fc .fc-list-event.ev-agendado .fc-list-event-dot{border-color:var(--info)}
    .fc .fc-list-event.ev-confirmado .fc-list-event-dot{border-color:var(--ok)}
    .fc .fc-list-event.ev-remarcado .fc-list-event-dot{border-color:var(--warn)}
    .fc .fc-list-event.ev-cancelado .fc-list-event-dot{border-color:var(--muted)}
    .fc .fc-list-event.ev-faltou .fc-list-event-dot{border-color:var(--danger)}
    .fc .fc-list-event td{color:var(--ink)}
    .fc .fc-timegrid-slot{height:2em}
    .fc .fc-scrollgrid{border-radius:var(--r-sm);overflow:hidden}
    .fc .fc-day-sat,.fc .fc-day-sun{background:var(--card-2)}
    .fc .fc-day-today{background:var(--fc-today-bg-color)!important}
    .fc .fc-non-business{
      background:repeating-linear-gradient(45deg,transparent,transparent 6px,var(--line) 6px,var(--line) 7px);
      opacity:.5;
    }

    @media print{
      .rail,.ctxbar,.rail-fundo,.topbar,.tabs,.btn,.icon-btn{display:none!important}
      .shell-main,:root[data-rail="fixo"] .shell-main{margin-left:0}
      .card{box-shadow:none;break-inside:avoid}
    }
    @media (prefers-reduced-motion: reduce){
      *{transition:none!important;animation:none!important}
    }
  </style>
</head>
