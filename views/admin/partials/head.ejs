<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel · Agente WhatsApp</title>
  <style>
    :root{
      color-scheme: light;
      --bg:#f0f2f5; --card:#ffffff; --ink:#111b21; --muted:#667781; --line:#e4e8eb;
      --brand:#128c7e; --brand-ink:#ffffff; --danger:#c0392b; --ok:#0f7a3d;
      --warn:#b45309;
      --shadow:0 1px 2px rgba(16,24,40,.06),0 1px 3px rgba(16,24,40,.08);
      --radius:12px;
    }
    @media (prefers-color-scheme: dark){
      :root{
        color-scheme: dark;
        --bg:#0b141a; --card:#141f26; --ink:#e9edef; --muted:#8696a0; --line:#2a3942;
        --brand:#00a884; --brand-ink:#08120e; --danger:#f0806c; --ok:#69d18f;
        --warn:#e0a34a;
        --shadow:0 1px 2px rgba(0,0,0,.4);
      }
    }
    *{box-sizing:border-box}
    body{margin:0;font:15px/1.55 system-ui,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
    a{color:var(--brand);text-decoration:none}
    a:hover{text-decoration:underline}

    .topbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;background:var(--brand);color:var(--brand-ink);padding:12px 20px;box-shadow:var(--shadow)}
    .topbar .brand{color:var(--brand-ink);font-weight:600;font-size:16px}
    .topbar .brand:hover{text-decoration:none;opacity:.9}

    .container{max-width:1000px;margin:22px auto;padding:0 16px}

    /* Sub-navegação da página da clínica */
    .subnav{position:sticky;top:0;z-index:10;display:flex;gap:6px;flex-wrap:wrap;background:var(--bg);padding:10px 0;margin:-2px 0 8px;border-bottom:1px solid var(--line)}
    .subnav a{padding:6px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--ink);font-size:13px;font-weight:500}
    .subnav a:hover{border-color:var(--brand);color:var(--brand);text-decoration:none}

    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;margin:14px 0;box-shadow:var(--shadow)}
    h1{font-size:23px;margin:.2em 0;letter-spacing:-.01em}
    h2{font-size:16px;margin:1.3em 0 .5em;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
    h2:first-child{margin-top:.2em}

    .row{display:flex;gap:12px;align-items:center}
    .between{justify-content:space-between}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width:620px){.grid2{grid-template-columns:1fr}}

    label{display:block;margin:10px 0;font-size:13px;font-weight:500;color:var(--muted)}
    input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]),textarea,select{
      width:100%;padding:9px 11px;margin-top:4px;border:1px solid var(--line);border-radius:9px;font:inherit;
      background:var(--card);color:var(--ink);color-scheme:inherit}
    input[type=datetime-local],input[type=date],input[type=time]{min-height:40px}
    input[type=datetime-local]::-webkit-calendar-picker-indicator,
    input[type=date]::-webkit-calendar-picker-indicator,
    input[type=time]::-webkit-calendar-picker-indicator{filter:invert(.5) sepia(1) saturate(3) hue-rotate(120deg);cursor:pointer}
    input:focus,textarea:focus,select:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(18,140,126,.15)}
    textarea{min-height:74px;resize:vertical}

    .inline{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
    .inline>*{flex:1}
    .inline .btn{flex:0 0 auto}

    .btn{display:inline-flex;align-items:center;gap:6px;background:var(--brand);color:var(--brand-ink);border:0;border-radius:9px;padding:10px 16px;font:inherit;font-weight:600;cursor:pointer;transition:filter .12s}
    .btn:hover{filter:brightness(1.06)}
    .btn.sm{padding:6px 11px;font-size:13px;border-radius:8px}
    .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);font-weight:500}
    .btn.ghost:hover{border-color:var(--brand);color:var(--brand)}
    .btn.danger{background:transparent;color:var(--danger);border:1px solid var(--danger);font-weight:500}
    .btn.danger:hover{background:var(--danger);color:#fff;filter:none}
    .link{background:none;border:0;color:var(--brand-ink);cursor:pointer;font:inherit;text-decoration:underline;padding:0}

    table{width:100%;border-collapse:collapse;margin-top:8px}
    th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);font-size:14px;vertical-align:middle}
    tr:last-child td{border-bottom:0}
    th{color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.03em}

    .pill{display:inline-block;background:var(--line);border-radius:999px;padding:3px 10px;font-size:12px;margin:2px}
    .ok{background:transparent;border:1px solid var(--ok);color:var(--ok);padding:10px 12px;border-radius:9px;font-size:14px}
    .erro{background:transparent;border:1px solid var(--danger);color:var(--danger);padding:10px 12px;border-radius:9px;font-size:14px}
    .muted{color:var(--muted);font-size:13px}

    .login-wrap{min-height:100vh;display:grid;place-items:center;padding:16px}
    .login{width:340px}

    .checks{display:flex;gap:16px;flex-wrap:wrap}
    .checks label{display:flex;align-items:center;gap:7px;color:var(--ink);margin:5px 0;font-weight:500}
    .checks input{width:auto;margin:0}

    fieldset{border:1px solid var(--line);border-radius:10px;margin:10px 0;padding:12px}
    legend{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.03em;padding:0 6px}

    /* ---- FullCalendar: integra com o tema (claro/escuro) ---- */
    .fc{--fc-border-color:var(--line);--fc-page-bg-color:var(--card);--fc-neutral-bg-color:var(--bg);
        --fc-today-bg-color:rgba(18,140,126,.07);--fc-now-indicator-color:#e0554a;
        --fc-event-border-color:transparent;--fc-small-font-size:12px;
        --fc-list-event-hover-bg-color:var(--bg)}
    /* Visão em lista: texto legível e hover no tema */
    .fc .fc-list-event-title a,.fc .fc-list-event-time{color:var(--ink)}
    .fc .fc-list-event:hover td{background:var(--bg)}
    .fc .fc-list-day-cushion{background:var(--bg);color:var(--muted)}
    .fc .fc-list-empty{background:var(--card);color:var(--muted)}
    /* Conteúdo do evento: paciente + médico embaixo */
    .fc .ev{overflow:hidden;line-height:1.25}
    .fc .ev-t{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc .ev-m{font-size:11px;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    @media (prefers-color-scheme: dark){ .fc{--fc-today-bg-color:rgba(0,168,132,.12)} }
    :root[data-theme="dark"] .fc{--fc-today-bg-color:rgba(0,168,132,.12)}
    .fc a{color:inherit;text-decoration:none}
    .fc .fc-toolbar-title{font-size:18px;font-weight:600;letter-spacing:-.01em}
    .fc .fc-toolbar.fc-header-toolbar{margin-bottom:14px;gap:8px;flex-wrap:wrap}
    .fc .fc-button{background:var(--card);border:1px solid var(--line);color:var(--ink);
        font-weight:500;font-size:13px;padding:6px 12px;border-radius:8px;box-shadow:none;text-transform:capitalize}
    .fc .fc-button:hover{background:var(--bg);border-color:var(--brand);color:var(--brand)}
    .fc .fc-button:focus{box-shadow:0 0 0 3px rgba(18,140,126,.15)!important}
    .fc .fc-button-primary:not(:disabled).fc-button-active,
    .fc .fc-button-primary:not(:disabled):active{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
    .fc .fc-button-primary:disabled{background:var(--card);border-color:var(--line);color:var(--muted);opacity:.6}
    .fc .fc-col-header-cell{background:var(--bg);padding:8px 2px;font-size:12px;font-weight:600;
        text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
    .fc .fc-daygrid-day-number,.fc .fc-timegrid-slot-label-cushion{color:var(--muted);font-size:12px}
    .fc .fc-day-today .fc-daygrid-day-number{color:var(--brand);font-weight:700}
    .fc .fc-event{border-radius:6px;padding:1px 4px;font-size:12px;font-weight:500;cursor:pointer}
    .fc .fc-event:hover{filter:brightness(1.08)}
    .fc .fc-timegrid-slot{height:2.1em}
    .fc .fc-scrollgrid{border-radius:10px;overflow:hidden}
    .fc .fc-day-sat,.fc .fc-day-sun{background:var(--bg)}
    .fc .fc-day-today{background:var(--fc-today-bg-color)!important}
    .fc .fc-non-business{background:repeating-linear-gradient(45deg,transparent,transparent 6px,var(--line) 6px,var(--line) 7px);opacity:.45}

    /* Modal simples (agendamento) */
    dialog{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);color:var(--ink);
        padding:20px;max-width:460px;width:92%;box-shadow:0 10px 40px rgba(0,0,0,.25)}
    dialog::backdrop{background:rgba(0,0,0,.45)}

    /* Caixa de entrada */
    .inbox{display:grid;grid-template-columns:300px 1fr;gap:14px;align-items:start}
    @media (max-width:760px){.inbox{grid-template-columns:1fr}}
    .conv{display:block;padding:10px;border-radius:9px;color:var(--ink);border:1px solid transparent}
    .conv:hover{background:var(--bg);text-decoration:none}
    .conv.sel{background:var(--bg);border-color:var(--brand)}
    .thread{max-height:52vh;overflow-y:auto;display:flex;flex-direction:column;gap:5px;margin-top:12px;padding-right:4px}
    .bolha{width:fit-content;max-width:min(62%,360px);padding:6px 8px 4px;border-radius:8px;font-size:14px;
        line-height:1.35;box-shadow:0 1px 1px rgba(11,20,26,.13)}
    .bolha .txt{white-space:pre-line;overflow-wrap:anywhere}
    .bolha.in{align-self:flex-start;background:var(--bg);border:1px solid var(--line);border-top-left-radius:2px}
    .bolha.out{align-self:flex-end;background:color-mix(in srgb,var(--brand) 18%,transparent);border-top-right-radius:2px}
    .bolha .meta{font-size:11px;color:var(--muted);margin-top:2px;line-height:1.2;text-align:right;white-space:nowrap}
    @media (max-width:760px){.bolha{max-width:85%}}

    /* Dashboard de clínicas */
    .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px;margin-top:16px}
    .cards .card{margin:0;transition:border-color .12s,transform .12s}
    a.card:hover{border-color:var(--brand);transform:translateY(-1px);text-decoration:none}
    .badge{display:inline-block;font-size:12px;font-weight:600;padding:2px 10px;border-radius:999px;white-space:nowrap}
    .badge.on{border:1px solid var(--ok);color:var(--ok)}
    .badge.off{border:1px solid var(--muted);color:var(--muted)}
    /* Status de agendamento */
    .st{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;white-space:nowrap}
    .st::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
    .st-agendado{color:var(--brand);background:color-mix(in srgb,var(--brand) 12%,transparent)}
    .st-confirmado{color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,transparent)}
    .st-cancelado{color:var(--muted);background:color-mix(in srgb,var(--muted) 14%,transparent)}
    .st-remarcado{color:var(--warn);background:color-mix(in srgb,var(--warn) 14%,transparent)}
    .st-faltou{color:var(--danger);background:color-mix(in srgb,var(--danger) 12%,transparent)}
    .stat{display:flex;gap:20px;margin-top:12px}
    .stat b{display:block;font-size:19px;color:var(--ink);line-height:1.1}
    .stat span{font-size:12px;color:var(--muted)}

    /* Cartões de métrica */
    .metrica b{display:block;font-size:30px;font-weight:700;line-height:1.1;letter-spacing:-.02em}
    .metrica b.bom{color:var(--ok)}
    .metrica b.ruim{color:var(--danger)}
    .metrica span{display:block;margin-top:6px;font-size:13px;color:var(--muted)}
  </style>
</head>
