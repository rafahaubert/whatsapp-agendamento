<!doctype html>
<html lang="pt-BR">
<%- include('partials/head', { tituloPagina: "Entrar" }) %>
<body>
  <div class="login-wrap">
    <form method="post" action="/admin/login" class="card login">
      <div class="brand-block">
        <%- include('partials/marca', { marcaVariante: "bloco" }) %>
      </div>
      <% if (erro) { %><p class="erro"><%= erro %></p><% } %>
      <label>Usuário<input name="user" autofocus autocomplete="username" /></label>
      <label>Senha<input type="password" name="password" autocomplete="current-password" /></label>
      <button class="btn" style="width:100%;margin-top:14px">Entrar</button>
    </form>
  </div>
</body>
</html>
