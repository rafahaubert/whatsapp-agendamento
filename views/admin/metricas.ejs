<%- include('partials/header', { tituloPagina: "Métricas" }) %>
<%
  var m = metricas;
  function num(v){ return (v || 0).toLocaleString("pt-BR"); }
  function pct(v){ return v === null ? "—" : v.toFixed(v >= 10 ? 0 : 1).replace(".", ",") + "%"; }
  function larg(v){ return v === null ? 0 : Math.max(0, Math.min(100, v)); }
  // Faixas de severidade — o preenchimento do medidor carrega o estado;
  // o rótulo ao lado repete a leitura, então a cor nunca decide sozinha.
  function faixaFalta(v){ return v === null ? "m-info" : v > 15 ? "m-danger" : v > 10 ? "m-warn" : "m-ok"; }
  function faixaConf(v){ return v === null ? "m-info" : v >= 70 ? "m-ok" : v >= 40 ? "m-warn" : "m-danger"; }
  var realizadas = m.compareceram + m.faltaram;
  var pctPresenca = realizadas ? (m.compareceram / realizadas) * 100 : 0;
  var pctFalta = realizadas ? (m.faltaram / realizadas) * 100 : 0;
  var semResposta = Math.max(0, m.lembretesEnviados - m.lembretesConfirmados);
%>

<div class="page-head">
  <div>
    <p class="eyebrow"><a href="/admin/clinicas/<%= t.id %>">← <%= t.name %></a></p>
    <h1>Métricas</h1>
  </div>
  <div class="row tight" role="group" aria-label="Período">
    <% [7, 30, 90].forEach(function(d){ %>
      <a class="btn sm <%= dias === d ? '' : 'ghost' %>"
         href="/admin/clinicas/<%= t.id %>/metricas?dias=<%= d %>"
         <%= dias === d ? 'aria-current="true"' : "" %>><%= d %> dias</a>
    <% }) %>
  </div>
</div>

<!-- ===================== Cabeçalho: o número que importa ===================== -->
<div class="kpis" style="margin-bottom:14px">
  <div class="kpi hero">
    <span class="rot">Agendamentos criados</span>
    <span class="val"><%= num(m.agendamentos) %></span>
    <span class="sub">nos últimos <%= m.dias %> dias · sem ocupar a recepção</span>
  </div>

  <div class="kpi">
    <span class="rot">Taxa de falta</span>
    <span class="val"><%= pct(m.taxaFalta) %></span>
    <span class="meter <%= faixaFalta(m.taxaFalta) %>"><i style="width:<%= larg(m.taxaFalta) %>%"></i></span>
    <span class="sub">
      <% if (m.taxaFalta === null) { %>sem desfecho marcado ainda<% }
         else { %><b><%= num(m.faltaram) %></b> faltas em <%= num(realizadas) %> consultas<% } %>
    </span>
  </div>

  <div class="kpi">
    <span class="rot">Lembretes confirmados</span>
    <span class="val"><%= pct(m.taxaConfirmacao) %></span>
    <span class="meter <%= faixaConf(m.taxaConfirmacao) %>"><i style="width:<%= larg(m.taxaConfirmacao) %>%"></i></span>
    <span class="sub"><b><%= num(m.lembretesConfirmados) %></b> de <%= num(m.lembretesEnviados) %> lembretes enviados</span>
  </div>

  <div class="kpi">
    <span class="rot">Mensagens fora do horário</span>
    <span class="val"><%= pct(m.percentualForaHorario) %></span>
    <span class="meter m-info"><i style="width:<%= larg(m.percentualForaHorario) %>%"></i></span>
    <span class="sub"><b><%= num(m.foraDoHorario) %></b> mensagens — todas atendidas na hora</span>
  </div>
</div>

<% if (m.taxaFalta === null) { %>
  <p class="muted" style="margin:-4px 0 14px">
    A taxa de falta aparece quando a recepção começar a marcar <strong>Compareceu / Faltou</strong>
    nas consultas passadas (aba <a href="/admin/clinicas/<%= t.id %>#agenda">Agenda</a>).
  </p>
<% } %>

<!-- ===================== Consultas ===================== -->
<div class="card">
  <div class="card-head">
    <h2>Consultas do período</h2>
    <span class="muted"><%= num(realizadas) %> com desfecho marcado</span>
  </div>

  <% if (realizadas > 0) { %>
    <div class="split" role="img"
         aria-label="<%= num(m.compareceram) %> compareceram, <%= num(m.faltaram) %> faltaram">
      <i class="seg-ok" style="width:<%= pctPresenca %>%"></i>
      <i class="seg-danger" style="width:<%= pctFalta %>%"></i>
    </div>
    <div class="legend">
      <span><i class="seg-ok"></i>Compareceram · <b style="color:var(--ink-2)"><%= num(m.compareceram) %></b></span>
      <span><i class="seg-danger"></i>Faltaram · <b style="color:var(--ink-2)"><%= num(m.faltaram) %></b></span>
    </div>
  <% } else { %>
    <p class="muted" style="margin-top:0">Nenhuma consulta com desfecho marcado neste período.</p>
  <% } %>

  <div class="table-wrap" style="margin-top:12px">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Período</th><th>Leitura</th></tr></thead>
      <tbody>
        <tr>
          <td>Agendamentos criados</td>
          <td class="num"><%= num(m.agendamentos) %></td>
          <td class="muted">pedidos que viraram consulta</td>
        </tr>
        <tr>
          <td>Confirmados pelo paciente</td>
          <td class="num"><%= num(m.confirmados) %></td>
          <td><span class="st st-confirmado">confirmado</span></td>
        </tr>
        <tr>
          <td>Cancelados</td>
          <td class="num"><%= num(m.cancelados) %></td>
          <td><span class="st st-cancelado">cancelado</span></td>
        </tr>
        <tr>
          <td>Compareceram</td>
          <td class="num"><%= num(m.compareceram) %></td>
          <td class="muted">desfecho marcado pela recepção</td>
        </tr>
        <tr>
          <td>Faltaram</td>
          <td class="num"><%= num(m.faltaram) %></td>
          <td><span class="st st-faltou">faltou</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- ===================== Lembretes ===================== -->
<div class="card">
  <div class="card-head">
    <h2>Lembretes (anti-falta)</h2>
    <span class="muted"><%= num(m.lembretesEnviados) %> enviados</span>
  </div>

  <% if (m.lembretesEnviados > 0) { %>
    <div class="split" role="img"
         aria-label="<%= num(m.lembretesConfirmados) %> confirmaram, <%= num(semResposta) %> sem resposta">
      <i class="seg-ok" style="width:<%= (m.lembretesConfirmados / m.lembretesEnviados) * 100 %>%"></i>
      <i class="seg-muted" style="width:<%= (semResposta / m.lembretesEnviados) * 100 %>%"></i>
    </div>
    <div class="legend">
      <span><i class="seg-ok"></i>Confirmaram presença · <b style="color:var(--ink-2)"><%= num(m.lembretesConfirmados) %></b></span>
      <span><i class="seg-muted"></i>Sem resposta · <b style="color:var(--ink-2)"><%= num(semResposta) %></b></span>
    </div>
  <% } else { %>
    <p class="muted" style="margin-top:0">
      Nenhum lembrete enviado no período. Ative os lembretes na
      <a href="/admin/clinicas/<%= t.id %>#config">configuração da clínica</a>.
    </p>
  <% } %>
</div>

<!-- ===================== Atendimento ===================== -->
<div class="card">
  <div class="card-head"><h2>Atendimento pelo WhatsApp</h2></div>
  <div class="kpis">
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Conversas</span>
      <span class="val sm"><%= num(m.conversas) %></span>
      <span class="sub">pacientes atendidos no período</span>
    </div>
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Mensagens recebidas</span>
      <span class="val sm"><%= num(m.mensagensRecebidas) %></span>
      <span class="sub"><b><%= num(m.foraDoHorario) %></b> fora do horário</span>
    </div>
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Respostas enviadas</span>
      <span class="val sm"><%= num(m.mensagensEnviadas) %></span>
      <span class="sub">pelo agente e pela recepção</span>
    </div>
  </div>
</div>

<% if (ehSuper) { %>
  <!-- ===================== Consumo (só administrador) ===================== -->
  <div class="card">
    <div class="card-head">
      <h2>Consumo de IA</h2>
      <span class="muted">visível só para o administrador</span>
    </div>
    <div class="kpis">
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Tokens de entrada</span>
        <span class="val sm"><%= num(m.tokensEntrada) %></span>
      </div>
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Tokens de saída</span>
        <span class="val sm"><%= num(m.tokensSaida) %></span>
      </div>
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Custo estimado</span>
        <span class="val sm">US$ <%= m.custoEstimadoUSD.toFixed(2) %></span>
        <span class="sub">modelo <code><%= t.parsedConfig.ai.model %></code></span>
      </div>
    </div>
    <p class="muted" style="margin-bottom:0">
      Estimativa com base nos preços por milhão de tokens do modelo configurado —
      confirme os valores atuais antes de usar em proposta comercial.
    </p>
  </div>
<% } %>
<%- include('partials/footer') %>
