<%- include('partials/header', { tituloPagina: "Métricas" }) %>
<%
  var m = metricas;
  function num(v){ return (v || 0).toLocaleString("pt-BR"); }
  function pct(v){ return v === null ? "—" : v.toFixed(v >= 10 ? 0 : 1).replace(".", ",") + "%"; }
  function larg(v){ return v === null ? 0 : Math.max(0, Math.min(100, v)); }
  // Faixas de severidade — o preenchimento do medidor carrega o estado;
  // o rótulo ao lado repete a leitura, então a cor nunca decide sozinha.
  function faixaFalta(v){ return v === null ? "m-info" : v > 15 ? "m-danger" : v > 10 ? "m-warn" : "m-ok"; }
  function faixaConf(v){ return v === null ? "m-info" : v >= 70 ? "m-ok" : v >= 40 ? "m-warn" : "m-danger"; }
  var realizadas = m.compareceram + m.faltaram;
  var pctPresenca = realizadas ? (m.compareceram / realizadas) * 100 : 0;
  var pctFalta = realizadas ? (m.faltaram / realizadas) * 100 : 0;
  var semResposta = Math.max(0, m.lembretesEnviados - m.lembretesConfirmados);
%>

<div class="page-head">
  <div>
    <h1>Métricas</h1>
  </div>
  <div class="row tight" role="group" aria-label="Período">
    <% [7, 30, 90].forEach(function(d){ %>
      <a class="btn sm <%= dias === d ? '' : 'ghost' %>"
         href="/admin/clinicas/<%= t.id %>/metricas?dias=<%= d %>"
         <%= dias === d ? 'aria-current="true"' : "" %>><%= d %> dias</a>
    <% }) %>
  </div>
</div>

<!-- ===================== Cabeçalho: o número que importa ===================== -->
<div class="kpis" style="margin-bottom:14px">
  <div class="kpi hero">
    <span class="rot">Agendamentos criados</span>
    <span class="val"><%= num(m.agendamentos) %></span>
    <span class="sub">nos últimos <%= m.dias %> dias · sem ocupar a recepção</span>
  </div>

  <div class="kpi">
    <span class="rot">Taxa de falta</span>
    <span class="val"><%= pct(m.taxaFalta) %></span>
    <span class="meter <%= faixaFalta(m.taxaFalta) %>"><i style="width:<%= larg(m.taxaFalta) %>%"></i></span>
    <span class="sub">
      <% if (m.taxaFalta === null) { %>sem desfecho marcado ainda<% }
         else { %><b><%= num(m.faltaram) %></b> faltas em <%= num(realizadas) %> consultas<%
           if (m.desfechosPresumidos) { %> · <%= num(m.desfechosPresumidos) %> presumidas<% }
         } %>
    </span>
  </div>

  <div class="kpi">
    <span class="rot">Lembretes confirmados</span>
    <span class="val"><%= pct(m.taxaConfirmacao) %></span>
    <span class="meter <%= faixaConf(m.taxaConfirmacao) %>"><i style="width:<%= larg(m.taxaConfirmacao) %>%"></i></span>
    <span class="sub"><b><%= num(m.lembretesConfirmados) %></b> de <%= num(m.lembretesEnviados) %> lembretes enviados</span>
  </div>

  <div class="kpi">
    <span class="rot">Mensagens fora do horário</span>
    <span class="val"><%= pct(m.percentualForaHorario) %></span>
    <span class="meter m-info"><i style="width:<%= larg(m.percentualForaHorario) %>%"></i></span>
    <span class="sub"><b><%= num(m.foraDoHorario) %></b> mensagens — todas atendidas na hora</span>
  </div>
</div>

<% if (m.taxaFalta === null) { %>
  <p class="muted" style="margin:-4px 0 14px">
    A taxa de falta aparece quando cada consulta passada tiver um desfecho. A recepção pode marcar
    <strong>Compareceu / Faltou</strong> na aba <a href="/admin/clinicas/<%= t.id %>#agenda">Agenda</a>,
    ou você liga a apuração automática em
    <a href="/admin/clinicas/<%= t.id %>/config/templates">Templates de mensagens</a> — o agente
    pergunta ao próprio paciente.
  </p>
<% } else if (m.desfechosPresumidos) { %>
  <p class="muted" style="margin:-4px 0 14px">
    <strong><%= num(m.desfechosPresumidos) %></strong> desfecho(s) foram <strong>presumidos</strong>
    por falta de resposta, não confirmados por ninguém. Quanto maior esse número, mais a taxa de
    falta é estimativa — ela tende a ficar otimista.
  </p>
<% } %>

<% if (m.usoDoPlano) { %>
  <div class="card">
    <div class="card-head">
      <h2>Plano <%= m.usoDoPlano.plano %></h2>
      <span class="muted">consumo do mês corrente</span>
    </div>
    <% if (m.usoDoPlano.cota === 0) { %>
      <p class="muted" style="margin:0"><strong><%= num(m.usoDoPlano.usados) %></strong> agendamento(s) neste mês. Plano sem cota definida.</p>
    <% } else { %>
      <div class="kpis">
        <div class="kpi">
          <span class="rot">Agendamentos no mês</span>
          <span class="val"><%= num(m.usoDoPlano.usados) %> / <%= num(m.usoDoPlano.cota) %></span>
          <span class="meter <%= m.usoDoPlano.estourou ? 'm-danger' : (m.usoDoPlano.perto ? 'm-warn' : 'm-ok') %>"><i style="width:<%= larg(Math.min(m.usoDoPlano.percentual, 100)) %>%"></i></span>
          <span class="sub"><%= pct(m.usoDoPlano.percentual) %> da cota</span>
        </div>
        <% if (m.usoDoPlano.estourou) { %>
          <div class="kpi">
            <span class="rot">Excedente</span>
            <span class="val"><%= (m.usoDoPlano.excedenteCentavos/100).toLocaleString("pt-BR", {style:"currency", currency:"BRL"}) %></span>
            <span class="sub"><b><%= num(m.usoDoPlano.excedentes) %></b> agendamento(s) acima da cota</span>
          </div>
        <% } %>
      </div>
      <%# A proposta comercial PROMETE avisar antes de virar fatura. Descobrir o
          excedente no boleto é a pior hora possível. %>
      <% if (m.usoDoPlano.estourou) { %>
        <p class="erro" style="margin:10px 0 0">A cota do mês foi ultrapassada. Os agendamentos excedentes entram na próxima fatura.</p>
      <% } else if (m.usoDoPlano.perto) { %>
        <p class="muted" style="margin:10px 0 0"><strong>Atenção:</strong> a cota do mês está perto do limite. Passando dela, cada agendamento a mais entra na fatura.</p>
      <% } %>
    <% } %>
  </div>
<% } %>

<!-- ===================== Dinheiro e agenda cheia ===================== -->
<div class="card">
  <div class="card-head">
    <h2>Faturamento e ocupação</h2>
    <span class="muted">últimos <%= m.dias %> dias</span>
  </div>
  <% var reais = function(c){ return (c/100).toLocaleString("pt-BR", {style:"currency", currency:"BRL"}); }; %>
  <div class="kpis">
    <div class="kpi">
      <span class="rot">Faturado (particular)</span>
      <span class="val"><%= reais(m.faturamentoCentavos) %></span>
      <span class="sub">consultas já realizadas</span>
    </div>
    <div class="kpi">
      <span class="rot">Agendado a receber</span>
      <span class="val"><%= reais(m.faturamentoPrevistoCentavos) %></span>
      <span class="sub">consultas marcadas e ainda não realizadas</span>
    </div>
    <div class="kpi">
      <span class="rot">Ocupação dos próximos <%= m.diasAdiante %> dias</span>
      <span class="val"><%= pct(m.ocupacaoAdiante) %></span>
      <span class="meter m-info"><i style="width:<%= larg(m.ocupacaoAdiante) %>%"></i></span>
      <span class="sub"><b><%= num(m.horariosLivresAdiante) %></b> horários livres para vender</span>
    </div>
  </div>

  <% if (m.consultasSemPreco) { %>
    <p class="muted" style="margin:8px 0 0">
      <strong><%= num(m.consultasSemPreco) %></strong> consulta(s) do período ficaram de fora por não terem
      <strong>valor particular</strong> cadastrado — o total acima é menor que o real. Cadastre os valores em
      <a href="/admin/clinicas/<%= t.id %>/config/catalogo#especialidades">Catálogo → Especialidades</a>.
    </p>
  <% } %>
  <p class="muted" style="margin:8px 0 0">Atendimentos por <strong>convênio</strong> não entram: o valor depende do plano e do repasse, que o sistema não conhece.</p>

  <% if (m.faturamentoPorEspecialidade.length) { %>
    <div class="table-wrap" style="margin-top:12px">
      <table>
        <thead><tr><th>Especialidade</th><th>Consultas</th><th>Faturado</th></tr></thead>
        <tbody>
          <% m.faturamentoPorEspecialidade.forEach(function(e){ %>
            <tr>
              <td><%= e.especialidade %></td>
              <td><%= num(e.consultas) %></td>
              <td><%= reais(e.centavos) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ===================== Consultas ===================== -->
<div class="card">
  <div class="card-head">
    <h2>Consultas do período</h2>
    <span class="muted"><%= num(realizadas) %> com desfecho marcado</span>
  </div>

  <% if (realizadas > 0) { %>
    <div class="split" role="img"
         aria-label="<%= num(m.compareceram) %> compareceram, <%= num(m.faltaram) %> faltaram">
      <i class="seg-ok" style="width:<%= pctPresenca %>%"></i>
      <i class="seg-danger" style="width:<%= pctFalta %>%"></i>
    </div>
    <div class="legend">
      <span><i class="seg-ok"></i>Compareceram · <b style="color:var(--ink-2)"><%= num(m.compareceram) %></b></span>
      <span><i class="seg-danger"></i>Faltaram · <b style="color:var(--ink-2)"><%= num(m.faltaram) %></b></span>
    </div>
  <% } else { %>
    <p class="muted" style="margin-top:0">Nenhuma consulta com desfecho marcado neste período.</p>
  <% } %>

  <div class="table-wrap" style="margin-top:12px">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Período</th><th>Leitura</th></tr></thead>
      <tbody>
        <tr>
          <td>Agendamentos criados</td>
          <td class="num"><%= num(m.agendamentos) %></td>
          <td class="muted">pedidos que viraram consulta</td>
        </tr>
        <tr>
          <td>Confirmados pelo paciente</td>
          <td class="num"><%= num(m.confirmados) %></td>
          <td><span class="st st-confirmado">confirmado</span></td>
        </tr>
        <tr>
          <td>Cancelados</td>
          <td class="num"><%= num(m.cancelados) %></td>
          <td><span class="st st-cancelado">cancelado</span></td>
        </tr>
        <tr>
          <td>Compareceram</td>
          <td class="num"><%= num(m.compareceram) %></td>
          <td class="muted">desfecho marcado pela recepção</td>
        </tr>
        <tr>
          <td>Faltaram</td>
          <td class="num"><%= num(m.faltaram) %></td>
          <td><span class="st st-faltou">faltou</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- ===================== Lembretes ===================== -->
<div class="card">
  <div class="card-head">
    <h2>Lembretes (anti-falta)</h2>
    <span class="muted"><%= num(m.lembretesEnviados) %> enviados</span>
  </div>

  <% if (m.lembretesEnviados > 0) { %>
    <div class="split" role="img"
         aria-label="<%= num(m.lembretesConfirmados) %> confirmaram, <%= num(semResposta) %> sem resposta">
      <i class="seg-ok" style="width:<%= (m.lembretesConfirmados / m.lembretesEnviados) * 100 %>%"></i>
      <i class="seg-muted" style="width:<%= (semResposta / m.lembretesEnviados) * 100 %>%"></i>
    </div>
    <div class="legend">
      <span><i class="seg-ok"></i>Confirmaram presença · <b style="color:var(--ink-2)"><%= num(m.lembretesConfirmados) %></b></span>
      <span><i class="seg-muted"></i>Sem resposta · <b style="color:var(--ink-2)"><%= num(semResposta) %></b></span>
    </div>
  <% } else { %>
    <p class="muted" style="margin-top:0">
      Nenhum lembrete enviado no período. Ative os lembretes na
      <a href="/admin/clinicas/<%= t.id %>#config">configuração da clínica</a>.
    </p>
  <% } %>
</div>

<!-- ===================== Atendimento ===================== -->
<div class="card">
  <div class="card-head"><h2>Atendimento pelo WhatsApp</h2></div>
  <div class="kpis">
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Conversas</span>
      <span class="val sm"><%= num(m.conversas) %></span>
      <span class="sub">pacientes atendidos no período</span>
    </div>
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Mensagens recebidas</span>
      <span class="val sm"><%= num(m.mensagensRecebidas) %></span>
      <span class="sub"><b><%= num(m.foraDoHorario) %></b> fora do horário</span>
    </div>
    <div class="kpi" style="box-shadow:none;background:var(--card-2)">
      <span class="rot">Respostas enviadas</span>
      <span class="val sm"><%= num(m.mensagensEnviadas) %></span>
      <span class="sub">pelo agente e pela recepção</span>
    </div>
  </div>
</div>

<% if (ehSuper) { %>
  <!-- ===================== Consumo (só administrador) ===================== -->
  <div class="card">
    <div class="card-head">
      <h2>Consumo de IA</h2>
      <span class="muted">visível só para o administrador</span>
    </div>
    <div class="kpis">
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Tokens de entrada</span>
        <span class="val sm"><%= num(m.tokensEntrada) %></span>
      </div>
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Tokens de saída</span>
        <span class="val sm"><%= num(m.tokensSaida) %></span>
      </div>
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Custo estimado</span>
        <span class="val sm">US$ <%= m.custoEstimadoUSD.toFixed(2) %></span>
        <span class="sub">modelo <code><%= t.parsedConfig.ai.model %></code></span>
      </div>
      <%# O prefixo (ferramentas + prompt) é reenviado a cada ida ao modelo, e
          são várias por mensagem do paciente. O cache cobra 10% na releitura. %>
      <div class="kpi" style="box-shadow:none;background:var(--card-2)">
        <span class="rot">Economia com cache</span>
        <span class="val sm">US$ <%= m.economiaCacheUSD.toFixed(2) %></span>
        <span class="sub"><%= num(m.tokensCacheLeitura) %> tokens lidos do cache</span>
      </div>
    </div>
    <%# Economia zero tem duas causas MUITO diferentes: o cache não compensou, ou
        o prefixo não alcança o mínimo do modelo e a API o ignorou em silêncio. %>
    <% if (m.cacheAtivo === false) { %>
      <p class="erro" style="margin:10px 0">
        <strong>O prompt caching não está pegando.</strong> O modelo
        <code><%= t.parsedConfig.ai.model %></code> exige um prefixo de pelo menos
        <%= num(m.minPrefixoCacheModelo) %> tokens para cachear; abaixo disso a API ignora o pedido
        sem devolver erro. Um modelo com mínimo menor resolve — ou uma base de conhecimento maior.
      </p>
    <% } %>
    <p class="muted" style="margin-bottom:0">
      Estimativa com base nos preços por milhão de tokens do modelo configurado —
      confirme os valores atuais antes de usar em proposta comercial.
    </p>
  </div>
<% } %>
<%- include('partials/footer') %>
