<%- include('partials/header', { tituloPagina: "Início" }) %>
<%
  var base = "/admin/clinicas/" + t.id;
  var m = metricas;
  function num(v) { return (v || 0).toLocaleString("pt-BR"); }
  function pct(v) { return v === null ? "—" : v.toFixed(v >= 10 ? 0 : 1).replace(".", ",") + "%"; }
  function larg(v) { return v === null ? 0 : Math.max(0, Math.min(100, v)); }
  // Mesmas faixas de severidade da tela de Métricas — a régua não muda de tela.
  function faixaFalta(v) { return v === null ? "m-info" : v > 15 ? "m-danger" : v > 10 ? "m-warn" : "m-ok"; }

  // O que precisa de gente hoje. Esta é a razão da tela existir: abrir o painel
  // e ver o que está parado, em vez de cair num formulário de ajustes.
  var atrasos = [];
  if (pendentes) atrasos.push({
    url: base + "/inbox", rotulo: "conversa aguardando a recepção", plural: "conversas aguardando a recepção",
    qtd: pendentes, css: "m-danger",
  });
  if (semDesfecho.length) atrasos.push({
    url: base + "/agendamentos#desfecho", rotulo: "consulta passada sem desfecho", plural: "consultas passadas sem desfecho",
    qtd: semDesfecho.length, css: "m-warn",
  });

  var hoje = agendamentos.slice(0, 6);
%>

<div class="page-head">
  <div>
    <h1><%= t.name %>
      <% if (!t.isActive) { %>
        <span class="badge off" style="vertical-align:middle;margin-left:6px">Inativa</span>
      <% } %>
    </h1>
    <p class="muted" style="margin:4px 0 0">Visão geral dos últimos 30 dias.</p>
  </div>
  <div class="row tight">
    <a class="btn sm ghost" href="<%= base %>/calendario">Calendário</a>
    <a class="btn sm" href="<%= base %>/agendamentos">Novo agendamento</a>
  </div>
</div>

<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>

<!-- ============ PRECISA DE ATENÇÃO ============ -->
<% if (atrasos.length) { %>
  <div class="card" style="border-color:var(--line-2)">
    <div class="card-head"><h2>Precisa de você</h2></div>
    <div class="row" style="gap:10px">
      <% atrasos.forEach(function(a){ %>
        <a class="btn sm <%= a.css === 'm-danger' ? '' : 'ghost' %>" href="<%= a.url %>">
          <%= a.qtd %> <%= a.qtd === 1 ? a.rotulo : a.plural %>
        </a>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- ============ NÚMEROS ============ -->
<div class="kpis">
  <div class="kpi">
    <span class="rot">Agendamentos</span>
    <span class="val"><%= num(m.agendamentos) %></span>
    <span class="sub">criados nos últimos <%= m.dias %> dias</span>
  </div>

  <div class="kpi">
    <span class="rot">Taxa de confirmação</span>
    <span class="val"><%= pct(m.taxaConfirmacao) %></span>
    <span class="meter m-ok"><i style="width:<%= larg(m.taxaConfirmacao) %>%"></i></span>
    <span class="sub"><b><%= num(m.confirmados) %></b> confirmados pelo paciente</span>
  </div>

  <div class="kpi">
    <span class="rot">Taxa de falta</span>
    <span class="val"><%= pct(m.taxaFalta) %></span>
    <span class="meter <%= faixaFalta(m.taxaFalta) %>"><i style="width:<%= larg(m.taxaFalta) %>%"></i></span>
    <span class="sub"><b><%= num(m.faltaram) %></b> faltas em <%= num(m.compareceram + m.faltaram) %> consultas</span>
  </div>

  <div class="kpi">
    <span class="rot">Conversas no WhatsApp</span>
    <span class="val"><%= num(m.conversas) %></span>
    <span class="sub">
      <b><%= num(m.mensagensRecebidas) %></b> mensagens recebidas
      <% if (m.foraDoHorario) { %> · <%= num(m.foraDoHorario) %> fora do horário<% } %>
    </span>
  </div>
</div>

<div class="grid2" style="margin-top:12px">
  <!-- ============ PRÓXIMAS CONSULTAS ============ -->
  <div class="card">
    <div class="card-head">
      <h2>Próximas consultas</h2>
      <a class="muted" href="<%= base %>/agendamentos">ver todas (<%= agendamentos.length %>)</a>
    </div>
    <% if (hoje.length === 0) { %>
      <div class="empty">Nenhuma consulta marcada daqui para frente.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Quando</th><th>Paciente</th><th>Profissional</th><th>Status</th></tr></thead>
          <tbody>
            <% hoje.forEach(function(a){ %>
              <tr>
                <td><%= a.inicio %></td>
                <td><%= a.paciente %><div class="muted" style="font-size:11.5px"><%= a.especialidade %></div></td>
                <td><%= a.medico %></td>
                <td><span class="st <%= a.statusCss %>"><%= a.statusLabel %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- ============ ATALHOS E SAÚDE DA CONFIGURAÇÃO ============ -->
  <div class="card">
    <div class="card-head"><h2>Automações</h2><a class="muted" href="<%= base %>/config/templates">ajustar</a></div>
    <%
      var automacoes = [
        { nome: "Lembrete de consulta", ligado: cfg.reminders && cfg.reminders.enabled, ganho: "reduz faltas" },
        { nome: "Fila de espera", ligado: cfg.waitlist && cfg.waitlist.enabled, ganho: "aproveita cancelamentos" },
        { nome: "Reativação de pacientes", ligado: cfg.recall && cfg.recall.enabled, ganho: "traz quem sumiu" },
      ];
    %>
    <div class="table-wrap">
      <table>
        <tbody>
          <% automacoes.forEach(function(a){ %>
            <tr>
              <td>
                <%= a.nome %>
                <div class="muted" style="font-size:11.5px"><%= a.ganho %></div>
              </td>
              <td class="num">
                <span class="st <%= a.ligado ? 'st-confirmado' : 'st-cancelado' %>">
                  <%= a.ligado ? "Ativa" : "Desligada" %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <h3>Catálogo</h3>
    <div class="row" style="gap:18px">
      <span><b><%= t.units.length %></b> <span class="muted">unidade<%= t.units.length === 1 ? "" : "s" %></span></span>
      <span><b><%= t.specialties.length %></b> <span class="muted">especialidade<%= t.specialties.length === 1 ? "" : "s" %></span></span>
      <span><b><%= t.doctors.length %></b> <span class="muted">profissiona<%= t.doctors.length === 1 ? "l" : "is" %></span></span>
    </div>
    <p class="muted" style="margin:10px 0 0">
      <a href="<%= base %>/config/catalogo">Editar catálogo</a> ·
      <a href="<%= base %>/config/equipe">Editar equipe</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
