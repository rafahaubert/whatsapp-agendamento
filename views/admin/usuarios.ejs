<%- include('partials/header', { tituloPagina: "Usuários" }) %>
<div class="page-head">
  <div>
    <h1>Usuários do painel <span class="muted" style="font-weight:400">(<%= usuarios.length %>)</span></h1>
  </div>
  <span class="muted">Cada clínica enxerga apenas os próprios dados.</span>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>

<div class="card">
  <div class="card-head"><h2>Acessos</h2></div>
  <% if (usuarios.length === 0) { %>
    <div class="empty">Nenhum usuário cadastrado ainda — o login por variável de ambiente
      continua valendo como administrador até você criar o primeiro.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Clínica</th><th>Último acesso</th><th></th></tr></thead>
        <tbody>
          <% usuarios.forEach(function(u){ %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td class="muted"><%= u.email %></td>
              <td>
                <!-- Perfil é identidade, não estado: usa chip neutro. Os tokens
                     de status ficam reservados para bom/atenção/crítico. -->
                <span class="pill <%= u.role === 'SUPER' ? 'on' : '' %>">
                  <%= u.role === 'SUPER' ? 'Administrador' : 'Clínica' %>
                </span>
              </td>
              <td class="muted"><%= u.tenant ? u.tenant.name : (u.role === 'SUPER' ? 'todas' : '—') %></td>
              <td class="muted"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString("pt-BR") : "nunca" %></td>
              <td class="acoes">
                <div class="inline" style="gap:6px">
                  <form method="post" action="/admin/usuarios/<%= u.id %>/senha" class="inline" style="gap:6px;flex:0 0 auto">
                    <input name="senha" type="password" placeholder="Nova senha" style="max-width:140px" />
                    <button class="btn sm ghost">Redefinir</button>
                  </form>
                  <form method="post" action="/admin/usuarios/<%= u.id %>/ativo" style="flex:0 0 auto">
                    <input type="hidden" name="ativar" value="<%= u.isActive ? '' : 'on' %>" />
                    <button class="btn sm ghost"><%= u.isActive ? "Suspender" : "Reativar" %></button>
                  </form>
                  <form method="post" action="/admin/usuarios/<%= u.id %>/excluir" style="flex:0 0 auto"
                        onsubmit="return confirm('Remover o acesso de <%= u.name %>?')">
                    <button class="btn sm danger">Excluir</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-head"><h2>Novo acesso</h2></div>
  <form method="post" action="/admin/usuarios">
    <div class="grid2">
      <label>Nome<input name="nome" required placeholder="Recepção da Cassol" /></label>
      <label>E-mail<input name="email" type="email" required placeholder="recepcao@clinica.com.br" /></label>
      <label>Senha (mín. 8 caracteres)<input name="senha" type="password" required minlength="8" /></label>
      <label>Perfil
        <select name="role">
          <option value="CLINIC">Clínica (vê só a dela)</option>
          <option value="SUPER">Administrador da plataforma (vê tudo)</option>
        </select>
      </label>
    </div>
    <label>Clínica <span class="muted">(obrigatório para o perfil Clínica)</span>
      <select name="tenantId">
        <option value="">—</option>
        <% clinicas.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </label>
    <button class="btn sm" style="margin-top:10px">Criar acesso</button>
  </form>
</div>
<%- include('partials/footer') %>
