<%- include('partials/header', { tituloPagina: "Caixa de entrada" }) %>
<div class="page-head">
  <div>
    <h1>Caixa de entrada</h1>
  </div>
  <span class="muted" style="max-width:340px;text-align:right">
    A recepção assume a conversa; enquanto isso o bot fica em silêncio.
  </span>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>

<div class="inbox">
  <!-- Lista de conversas -->
  <div class="card conv-lista">
    <% if (conversas.length === 0) { %>
      <div class="empty">Nenhuma conversa ainda.</div>
    <% } %>
    <% conversas.forEach(function(c){ %>
      <a class="conv <%= c.telefone === telefone ? 'sel' : '' %>"
         href="/admin/clinicas/<%= t.id %>/inbox?telefone=<%= encodeURIComponent(c.telefone) %>">
        <div class="conv-topo">
          <strong style="font-variant-numeric:tabular-nums"><%= c.telefone %></strong>
          <span class="conv-hora"><%= c.ultimaEmTexto %></span>
        </div>
        <div class="conv-baixo">
          <span class="conv-previa"><%= c.previa || "—" %></span>
          <% if (c.aguardando) { %><span class="st st-remarcado">aguardando</span><% } %>
          <% if (!c.janelaAberta) { %><span class="conv-flag" title="Janela de 24h fechada">24h</span><% } %>
        </div>
      </a>
    <% }) %>
  </div>

  <!-- Conversa selecionada -->
  <div class="card">
    <% if (!telefone) { %>
      <div class="empty">Selecione uma conversa ao lado.</div>
    <% } else { %>
      <div class="card-head">
        <h2 style="font-variant-numeric:tabular-nums;font-size:13px;text-transform:none;letter-spacing:0;color:var(--ink)"><%= telefone %></h2>
        <form method="post" action="/admin/clinicas/<%= t.id %>/inbox/handoff">
          <%- include('partials/csrf') %>
          <input type="hidden" name="telefone" value="<%= telefone %>" />
          <input type="hidden" name="ativar" value="<%= atual && atual.aguardando ? '' : 'on' %>" />
          <button class="btn sm <%= atual && atual.aguardando ? 'ghost' : '' %>">
            <%= atual && atual.aguardando ? "Devolver ao bot" : "Assumir conversa" %>
          </button>
        </form>
      </div>

      <% if (atual && !atual.janelaAberta) { %>
        <p class="erro">
          Passaram mais de 24h desde a última mensagem do paciente — a Meta bloqueia respostas livres.
          Só é possível retomar por template aprovado.
        </p>
      <% } %>

      <div class="thread">
        <% if (thread.length === 0) { %><p class="muted" style="margin:auto">Sem mensagens registradas.</p><% } %>
        <% thread.forEach(function(m){ %>
          <div class="bolha <%= m.entrada ? 'in' : 'out' %>">
            <div class="txt"><%= m.texto %></div>
            <div class="meta"><%= m.entrada ? "paciente" : (m.autor === "HUMAN" ? "recepção" : "bot") %> · <%= m.quandoTexto %></div>
          </div>
        <% }) %>
      </div>

      <form method="post" action="/admin/clinicas/<%= t.id %>/inbox/responder" class="inline" style="margin-top:12px">
        <%- include('partials/csrf') %>
        <input type="hidden" name="telefone" value="<%= telefone %>" />
        <label style="flex:1">Responder como recepção
          <input name="texto" placeholder="Escreva sua mensagem…" required />
        </label>
        <button class="btn sm">Enviar</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
