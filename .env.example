# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------------
# Local: suba um Postgres com `docker compose up -d db` e use:
DATABASE_URL="postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_agent?schema=public"
# Em produção, use a connection string do provedor (Render/Railway/Supabase).

# ------------------------------------------------------------------
# Anthropic (Claude) — Fase 2
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — Fase 1
# ------------------------------------------------------------------
# Token que VOCÊ define e configura no painel da Meta para validar o webhook:
WHATSAPP_VERIFY_TOKEN=defina-um-token-secreto
# Segredo do app, usado para validar a assinatura (X-Hub-Signature-256) dos webhooks:
WHATSAPP_APP_SECRET=...
# Token de acesso para ENVIAR mensagens (pode ser global ou por-tenant):
WHATSAPP_ACCESS_TOKEN=...
# Versão da Graph API usada nas chamadas de envio:
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------
# Painel de administração (/admin)
# ------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=defina-uma-senha-forte
SESSION_SECRET=defina-um-segredo-aleatorio-longo

# ------------------------------------------------------------------
# Google Calendar (opcional) — sincroniza agendamentos com a agenda do dentista
# ------------------------------------------------------------------
# Chave JSON da CONTA DE SERVIÇO, em UMA LINHA. Se ausente, a sync fica desligada.
# Ver GOOGLE.md para o passo a passo. Ex.:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
GOOGLE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------
# Transcrição de áudio (opcional) — Groq Whisper
# ------------------------------------------------------------------
# Sem a chave, o bot pede que o paciente escreva em vez de ignorar o áudio.
# Crie em https://console.groq.com
GROQ_API_KEY=

# ------------------------------------------------------------------
# Lembretes por cron externo (opcional, mas recomendado no plano free)
# ------------------------------------------------------------------
# Token que protege POST /jobs/run e /jobs/reminders — ver WHATSAPP-TEMPLATES.md.
# Enviado no header `x-jobs-token`. Sem ele, os endpoints respondem 401 a TODAS as
# chamadas (fail-closed), então o cron externo não funciona.
JOBS_TOKEN=

# ------------------------------------------------------------------
# Testes de integração (opcional)
# ------------------------------------------------------------------
# Postgres SEPARADO do de desenvolvimento — o setup roda `prisma db push
# --force-reset` e APAGA os dados. Sem esta variável, `npm run test:integration`
# pula os testes em vez de falhar.
# TEST_DATABASE_URL="postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_test?schema=public"
